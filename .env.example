# CommerceFlow LOCAL DEVELOPMENT credentials. Copy to .env (gitignored) before
# `infrastructure/scripts/up.ps1`. These values are for a laptop only: never reuse them
# in any shared or production environment. Change them if you like; keep them unique.

COMPOSE_PROJECT_NAME=commerceflow

# PostgreSQL superuser (bootstrap only; services never use it)
POSTGRES_SUPERUSER_PASSWORD=local-superuser-change-me
# Read-only monitoring role used by postgres-exporter
MONITORING_DB_PASSWORD=local-monitoring-change-me

# One migrator (DDL), one service (DML) and - for publishers - one CDC role per database
PRODUCT_DB_MIGRATOR_PASSWORD=local-product-migrator
PRODUCT_DB_SERVICE_PASSWORD=local-product-service
PRODUCT_DB_CDC_PASSWORD=local-product-cdc
ORDER_DB_MIGRATOR_PASSWORD=local-order-migrator
ORDER_DB_SERVICE_PASSWORD=local-order-service
ORDER_DB_CDC_PASSWORD=local-order-cdc
INVENTORY_DB_MIGRATOR_PASSWORD=local-inventory-migrator
INVENTORY_DB_SERVICE_PASSWORD=local-inventory-service
INVENTORY_DB_CDC_PASSWORD=local-inventory-cdc
PAYMENT_DB_MIGRATOR_PASSWORD=local-payment-migrator
PAYMENT_DB_SERVICE_PASSWORD=local-payment-service
PAYMENT_DB_CDC_PASSWORD=local-payment-cdc
CUSTOMER_DB_MIGRATOR_PASSWORD=local-customer-migrator
CUSTOMER_DB_SERVICE_PASSWORD=local-customer-service
CUSTOMER_DB_CDC_PASSWORD=local-customer-cdc
PRICING_DB_MIGRATOR_PASSWORD=local-pricing-migrator
PRICING_DB_SERVICE_PASSWORD=local-pricing-service
PRICING_DB_CDC_PASSWORD=local-pricing-cdc
SHIPPING_DB_MIGRATOR_PASSWORD=local-shipping-migrator
SHIPPING_DB_SERVICE_PASSWORD=local-shipping-service
SHIPPING_DB_CDC_PASSWORD=local-shipping-cdc
NOTIFICATION_DB_MIGRATOR_PASSWORD=local-notification-migrator
NOTIFICATION_DB_SERVICE_PASSWORD=local-notification-service

# Redis ACL users (key prefix <service>:)
PRODUCT_REDIS_PASSWORD=local-product-redis
PRICING_REDIS_PASSWORD=local-pricing-redis
MONITORING_REDIS_PASSWORD=local-monitoring-redis

# Grafana admin (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me

# Host ports (container ports are unchanged). Defaults avoid clashing with a local
# PostgreSQL/Redis on 5432/6379.
CF_POSTGRES_HOST_PORT=15432
CF_REDIS_HOST_PORT=16379
